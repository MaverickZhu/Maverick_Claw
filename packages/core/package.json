{
  "name": "@maverick-claw/core",
  "version": "0.1.0",
  "description": "Core Gateway server for Maverick_Claw",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "mc-gateway": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.ts",
    "start": "node dist/cli.js",
    "benchmark": "tsx src/benchmark/run.ts",
    "benchmark:compare": "tsx src/benchmark/compare.ts",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src/**/*.ts"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@maverick-claw/shared": "workspace:*",
    "@sentry/node": "^10.48.0",
    "better-sqlite3": "^11.0.0",
    "bullmq": "^5.72.0",
    "fastify": "^4.28.0",
    "ioredis": "^5.10.1",
    "json5": "^2.2.3",
    "kysely": "^0.27.3",
    "node-cron": "^3.0.3",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "prom-client": "^15.1.3",
    "uuid": "^9.0.1",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "@types/node-cron": "^3.0.11",
    "@types/uuid": "^9.0.8",
    "@types/ws": "^8.5.10",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
